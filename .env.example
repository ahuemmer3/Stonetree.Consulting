# Kopie als .env anlegen und ausfüllen. Die .env wird NICHT committet.

# Domain der Website, ohne https:// (zum lokalen Testen: localhost)
DOMAIN=localhost

# --- E-Mail-Versand für das Kontaktformular ------------------------------
# SMTP-Daten bekommt ihr vom E-Mail-Anbieter (Anleitung: docs/hosting.md)
SMTP_HOST=smtp.example.de
SMTP_PORT=587
# starttls für Port 587, ssl für Port 465
SMTP_SECURITY=starttls
SMTP_USER=kontakt@eure-domain.de
SMTP_PASSWORD=
# Absenderadresse, muss beim Anbieter erlaubt sein (leer = SMTP_USER)
MAIL_FROM=
# Wer die Anfragen bekommt
CONTACT_RECIPIENT=kontakt@eure-domain.de

# Schutz gegen Massenversand: höchstens so viele Anfragen je IP ...
RATE_LIMIT_COUNT=5
# ... innerhalb dieser Sekunden
RATE_LIMIT_WINDOW=600
